<!-- nascTime uplink reflective QoS demo
     Authors: Afshin Zanganeh and How-Hang Liu (Technical University of Dresden) -->
<config>
    <!-- Addressing for the standalone uplink QoS demo. -->
    <interface hosts="tsnDeviceA" address="10.0.0.10" netmask="255.255.255.0"/>
    <interface hosts="nwTt" names="ethIf" address="10.0.0.1" netmask="255.255.255.0"/>

    <interface hosts="nwTt" names="pppIf" address="10.0.1.1" netmask="255.255.255.0"/>
    <interface hosts="upf" names="pppIf" address="10.0.1.2" netmask="255.255.255.0"/>

    <interface hosts="upf" names="ppp0" address="10.0.2.1" netmask="255.255.255.0"/>
    <interface hosts="gnb" names="pppIf" address="10.0.2.2" netmask="255.255.255.0"/>

    <interface hosts="gnb" names="cellular" address="10.0.3.1" netmask="255.255.255.0"/>
    <interface hosts="ue" names="cellular" address="10.0.3.2" netmask="255.255.255.0"/>

    <interface hosts="ue" names="eth0" address="192.168.1.1" netmask="255.255.255.0"/>
    <interface hosts="tsnDeviceB" address="192.168.1.10" netmask="255.255.255.0"/>
    <interface hosts="dsTt" address="0.0.0.0" netmask="0.0.0.0"/>

    <interface hosts="**" address="10.0.x.x" netmask="255.255.255.0"/>
</config>
