package nasctime.simulations.demos.ext_multiendpoint_test;

import nasctime.nodes.NwTt.NwTt;
import nasctime.nodes.NwTt.GptpSideband;
import nasctime.nodes.DsTt.DsTt;
import simu5g.nodes.gNodeB;
import nasctime.nodes.NGNodeB;
import nasctime.nodes.DsTt.NRUeDsTt;
import simu5g.nodes.Upf;
import simu5g.world.radio.LteChannelControl;
import simu5g.common.binder.Binder;
import simu5g.common.carrierAggregation.CarrierAggregation;
import inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator;
import inet.networklayer.ipv4.RoutingTableRecorder;
import inet.node.tsn.TsnDevice;
import inet.node.tsn.TsnSwitch;
import ned.DatarateChannel;

import nasctime.nodes.TsnAf.TsnAf;
import nasctime.nodes.TsnAf.StaticBmca;

//
// ExtendedMultiEndpointNetwork — parametric multi-endpoint 5G-TSN bridge topology.
//
// The endpointProfiles parameter is documentation only; per-endpoint app
// configuration is generated by gen_profile_ini.py from this string and
// included via the omnetpp.ini file.
//
// Supported profiles:
//   CLC = closed-loop control      (100 B  @ 1 ms,    PCP=7, deadline 2 ms)
//   MV  = machine vision + monitor (1500 B @ 5 ms HP, 500 B @ exp(2 ms) BE)
//   BLK = bulk / asset tracking    (1200 B @ exp(10 ms), best effort only)
//
network ExtendedMultiEndpointNetwork
{
    parameters:
        int numEndpoints = default(3);
        // Comma-separated profile assignment, one per endpoint.
        // Examples:
        //   N=1:  "CLC"
        //   N=5:  "CLC,CLC,MV,MV,BLK"
        //   N=10: "CLC,CLC,CLC,CLC,MV,MV,MV,MV,BLK,BLK"
        //   N=15: "CLC,CLC,CLC,CLC,CLC,MV,MV,MV,MV,MV,BLK,BLK,BLK,BLK,BLK"
        //   N=20: "CLC,CLC,CLC,CLC,CLC,CLC,CLC,MV,MV,MV,MV,MV,MV,MV,BLK,BLK,BLK,BLK,BLK,BLK"
        string endpointProfiles = default("CLC,MV,BLK");

		// --- FRER transport diversity flags (all default off) ---
        bool frerInterSession = default(false);
        bool frerDualConn = default(false);

        @display("bgb=1600,700");

    types:
        channel Eth1G extends DatarateChannel
        {
            datarate = 1Gbps;
            delay = 0.1us;
        }
        channel Eth10G extends DatarateChannel
        {
            datarate = 10Gbps;
            delay = 0.1us;
        }

    submodules:
        channelControl: LteChannelControl {
            @display("p=50,25;is=s");
        }
        routingRecorder: RoutingTableRecorder {
            @display("p=50,75;is=s");
        }
        configurator: Ipv4NetworkConfigurator {
            @display("p=50,125;is=s");
            config = xmldoc("multi_ip_config.xml");
        }
        binder: Binder {
            @display("p=50,175;is=s");
        }
        carrierAggregation: CarrierAggregation {
            @display("p=50,225;is=s");
        }

        // Shared infrastructure
        tsnDeviceA: TsnDevice {
            @display("p=100,350");
        }
        tsnSwitch: TsnSwitch {
            @display("p=250,350");
        }
        nwTt: NwTt {
            @display("p=420,350");
            ueAddress = "ue[0]";
            localAddress = "nwTt";
        }
        upf: Upf {
            @display("p=600,350");
        }
        gnb: NGNodeB {
            @display("p=780,350;is=vl");
        }

		// === Conditional: second UPF for inter-session FRER ===
        upf2: Upf if frerInterSession {
            @display("p=599,527");
        }

        // === Conditional: second gNB for NR-DC FRER ===
        gnb2: gNodeB if frerDualConn {
            @display("p=780,565;is=vl");
        }

        // Per-endpoint: UE + DS-TT + TSN Device B
        ue[numEndpoints]: NRUeDsTt {
            // Physical coordinates below are used by the radio/channel model.
            // Qtenv uses a separate column layout so dense UE deployments do
            // not render all device icons and labels on top of each other.
            @display("p=900,250,c,150");
            mobility.initialX = 455m + (index % 10) * 10m;
            mobility.initialY = 205m + (index / 10) * 10m;
            mobility.initialZ = 0m;
            mobility.initFromDisplayString = false;
            mobility.updateFromDisplayString = false;
            mobility.updateDisplayString = false;
        }
        dsTt[numEndpoints]: DsTt {
            @display("p=1120,250,c,150");
        }
        tsnDeviceB[numEndpoints]: TsnDevice {
            @display("p=1350,250,c,150");
        }
        tsnAf: TsnAf {
            @display("p=50,275;is=s");
            cncConfig = xmldoc("cnc_config.xml");
        }
        staticBmca: StaticBmca {
            @display("p=50,325;is=s");
        }

        // gPTP sideband (connects NW-TT to first DS-TT only for now)
        gptpSideband: GptpSideband {
            @display("p=770,150");
        }

    connections:
        // TSN domain A (shared)
        tsnDeviceA.ethg++ <--> Eth1G <--> tsnSwitch.ethg++;
        tsnSwitch.ethg++ <--> Eth1G <--> nwTt.tsnEthg;

        // === Primary N3 path: nwTt → upf → gnb (unchanged) ===
        nwTt.filterGate <--> Eth10G <--> upf.dnPppg;
        upf.pppg++ <--> Eth10G <--> gnb.ppp;

        // === Replica N3 path: nwTt → upf2 → gnb or gnb2 (conditional) ===
        nwTt.filterGate2 <--> Eth10G <--> upf2.dnPppg if frerInterSession;
        // Option A: upf2 → same gnb (inter-session, same scheduler)
        // REVIEW: gnb may need a second PPP gate (ppp2 or pppg[1]).
        // If gNodeBDrb inherits pppg[] from NetworkLayerNodeBase, use:
        //   upf2.pppg++ <--> Eth10G <--> gnb.pppg++ if frerInterSession && !frerDualConn;
        // If gnb has only a single 'ppp' gate, add 'inout ppp2;' to gNodeBDrb.ned.
        upf2.pppg++ <--> Eth10G <--> gnb.ppp2 if frerInterSession && !frerDualConn;

        // Option B: upf2 → gnb2 (NR-DC, independent scheduler)
        upf2.pppg++ <--> Eth10G <--> gnb2.ppp if frerDualConn;

        // Per-endpoint connections
        for i=0..numEndpoints-1 {
            ue[i].ethg <--> Eth1G <--> dsTt[i].ueEthg;
            dsTt[i].tsnEthg <--> Eth1G <--> tsnDeviceB[i].ethg++;
        }

        // gPTP sideband (to first DS-TT)
        nwTt.gptpSidebandOut --> gptpSideband.nwttIn;
        gptpSideband.dsttOut --> dsTt[0].gptpSidebandIn;
}
