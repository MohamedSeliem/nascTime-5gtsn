package nasctime.simulations.m2.m2b5;

import inet.clock.contract.IClock;
import inet.common.scenario.ScenarioManager;
import inet.queueing.contract.IPacketGate;
import inet.queueing.sink.PassivePacketSink;
import inet.queueing.source.ActivePacketSource;
import nasctime.m2.TtClock;

//
// M2B-5 TEST network (no 5G system): two "translators" A and B, each with the accepted TtClock, its TtGateClock and
// one common-epoch gate (TtEpochGate) bound to that clock. Gate schedules and TT clock parameters come from the
// configuration generated by check/test_m2b5_epoch_gate.py; their recorded gate transitions are compared with the
// independent oracle check/m2b5_oracle.py. Not part of any accepted configuration.
//
network EpochGateTest
{
    parameters:
        bool hasScenario = default(false);
    submodules:
        scenarioManager: ScenarioManager if hasScenario;
        ttClockA: TtClock;
        clockA: <default("nasctime.m2.TtGateClock")> like IClock;
        gateA: <default("nasctime.m2.TtEpochGate")> like IPacketGate {
            clockModule = default("^.clockA");
        }
        sourceA: ActivePacketSource;
        sinkA: PassivePacketSink;
        ttClockB: TtClock;
        clockB: <default("nasctime.m2.TtGateClock")> like IClock;
        gateB: <default("nasctime.m2.TtEpochGate")> like IPacketGate {
            clockModule = default("^.clockB");
        }
        sourceB: ActivePacketSource;
        sinkB: PassivePacketSink;
    connections:
        sourceA.out --> gateA.in;
        gateA.out --> sinkA.in;
        sourceB.out --> gateB.in;
        gateB.out --> sinkB.in;
}
