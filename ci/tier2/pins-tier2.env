# WP-E3a pins (one-time experimental hosted functional smoke run). Sourced by ci/tier2/lib/t2common.sh after the
# tier-1 pins. Plain KEY=VALUE only. Changing any value requires maintainer review.

# Authorised experiment identity
E3A_BRANCH=wp-e3/e3a-m2s4u-smoke
E3A_BASELINE=290babba3d12942344a2153f9ea5ea54287df366
E3A_ALLOWED_PATHS=".github/workflows/e3a-functional-smoke.yml ci/tier2/"

# Authorised simulation (exactly one): existing reviewed configuration, unchanged
SIM_CONFIG=M2S4U
SIM_RUN=0
SIM_REPEAT=10
SIM_NETWORK=M2S4LinkTest
SIM_TIME_LIMIT=3s
SIM_MAX_RUNS=1

# Resource limits. Byte units: 1 MB = 1 000 000 bytes (decimal). Sizes are apparent file sizes (du --apparent-size -b).
SIM_WALL_CAP_S=600
SIM_WATCHDOG_LIMIT_B=500000000
SIM_ACCEPT_LIMIT_B=200000000
SIM_WATCHDOG_POLL_S=1
SIM_WATCHDOG_MEASURE_TIMEOUT_S=20
CAP_T2_RUNCONFIG_S=180
CAP_T2_SIM_S=720

# U1 oracle (check_m2s4.py eval_unit, unchanged) and the adapter's non-vacuity guard
U1_REF_D_PS=50000
U1_MIN_EXCHANGES=25

# Historical OMNeT++ 6.4.0 reference hashes (INFORMATIONAL, E-9); identical in M2-S4 (2026-10-15), R181b and R181c
REF_CSV_TTA=5e00b95f4add87aaddce50358c250bbcee6a79d0927618388bb9254830303525
REF_CSV_TTB=9ce05ba3b133d8b9a9e06cc59c55bac8e308da64aa67a3b72f980eb2b4c58d12
REF_PCAP_TTA=79e2e880b3b711d581425493939e15a9e3bb852ccdc4795841af7e2b9b534d1f
REF_PCAP_TTB=9f3be3df9a625c97c9cbd9fe4a3871648063084828cb8b3ae4d1494b8b976ef8

# Publication. Diagnostics: screened text only (tier-1 policy, 20 MiB). Raw evidence: the sealed simulation outputs plus
# text records, content-checked per file type, at most this many bytes in total.
RAW_PUBLICATION_LIMIT_B=250000000
