# Reviewed pins for tier-1 CI (WP-E2c). Every value was verified in the accepted E2b.1 / E2b.3-R1 experiments.
# Changing any value requires maintainer review; tier-1 never "updates" a pin by itself.
# Sourced by ci/tier1/lib/common.sh (plain KEY=VALUE, no command substitution).

# Nix 2.34.4 (installer sha256 independently confirmed by the maintainer; tarball hash embedded in the installer)
NIX_VERSION=2.34.4
NIX_INSTALLER_URL=https://releases.nixos.org/nix/nix-2.34.4/install
NIX_INSTALLER_SHA256=de490f61fcbaf9a5cabf2fa621ddb9ef93ad35d9a23a04e7d51b26e092b63691
NIX_TARBALL_SHA256=595669eb6db6117135ca8ba6667b273eaf980a47523a92e61ed963556cd547b8
NIX_X="--extra-experimental-features nix-command --extra-experimental-features flakes"

# opp_env 0.36.2.261110 (PyPI wheel, no dependencies; main module sha256)
OPP_ENV_PIN=0.36.2.261110
OPP_ENV_WHEEL_URL=https://files.pythonhosted.org/packages/44/9a/c9643e77326634b92e14d2268ca8d82f4fd1da00166a5c99c5de5e2244d6/opp_env-0.36.2.261110-py3-none-any.whl
OPP_ENV_WHEEL_SHA256=7a962e2a58f56367a71322de8b65d007c8f31a917b5bdc4e6a9f032b6b6d4e73
OPP_ENV_MAIN_SHA256=233658171942a731a62ee8b77d86dc5845daaf964ee9675508d405db1bb4cfb9

# Approved 26.05 lock (byte-identical to the preserved VM lock; D-1) and the opp_env 0.36.2.261110 22.11 helper lock
LOCK_FILE=ci/tier1/flake.lock
LOCK_SHA256=9ead146500c1f8b54f2a611e0a753e705e35682639307c3ea7bd104f5109f60a
LOCK_SIZE=1462
HELPER_LOCK_SHA256=0fc40c96aefff3032f7ef727d4d498f7ceddf065503bcda81520c8624245618c
PROJECTS="omnetpp-6.5.0 inet-4.7.0 simu5g-1.8.1"

# Release assets as measured by separate streamed fetches in E2b.1, E2b.2, E2b.3 and E2b.3-R1 (identical each time).
# LIMITATION: these prove what a separate fetch receives, not the exact bytes opp_env consumed (it streams curl | tar).
ASSET_OMNETPP_URL=https://github.com/omnetpp/omnetpp/releases/download/omnetpp-6.5.0/omnetpp-6.5.0-linux-x86_64.tgz
ASSET_OMNETPP_SHA256=d4f40a1c8bc17a0d9a95a52b57f4c0476bd11effc2850edeb279d0608b0d5cbd
ASSET_INET_URL=https://github.com/inet-framework/inet/releases/download/v4.7.0/inet-4.7.0-src.tgz
ASSET_INET_SHA256=0de338f8de6acafa054627ed879efb49137973316cddbc161f60968faa8e4878
ASSET_SIMU5G_URL=https://github.com/Unipisa/Simu5G/releases/download/v1.8.1/simu5g-1.8.1-src.tgz
ASSET_SIMU5G_SHA256=a63b331839afc8d4c030b66644d4276f616413a476d0114b883a474e5f2b85b5

# Reference toolchain (F-7) and OMNeT++ configure.user (VM reference)
EXPECT_CLANG=21.1.8
EXPECT_GCC=15.2.0
EXPECT_MAKE=4.2.1
EXPECT_PYTHON=3.13.13
WITH_REFERENCE="WITH_PYTHON=yes WITH_QTENV=yes WITH_OSG=no WITH_OSGEARTH=no WITH_NETBUILDER=yes WITH_SCAVE_PYTHON_BINDINGS=yes WITH_LIBXML=no WITH_PARSIM=yes WITH_SYSTEMC=no WITH_BACKTRACE=yes WITH_AKAROA=no"
# SYS_LIBS of the original VM OMNeT++ 6.5.0 Makefile.inc (recovered by the maintainer); compared as ordered tokens (D-3)
VM_SYS_LIBS="-lstdc++ -lpython3.13 -ldl -lm -L/nix/store/qhmqdg27kcrlkl8ida6d5hiacw0y8d21-elfutils-0.194/lib -ldw -lelf"

# Wrapper regression suite (existing; never modified by tier-1)
WRAPPER_SUITE=simulations/m2/check/test_m2s72a2v1_wrapper.py
WRAPPER_EXPECTED_LINE="A2-V1 wrapper tests: 21 / 21 PASS"
WRAPPER_EXPECTED_TESTS=21

# Resource limits: 120-minute job; stage caps (seconds); a 10-minute reserve for evaluation and publication
JOB_BUDGET_S=7200
RESERVE_S=600
CAP_BOOTSTRAP_S=1200
CAP_RUNTIME_S=600
CAP_OMNETPP_S=1200
CAP_INET_S=2700
CAP_SIMU5G_S=1200
CAP_NASCTIME_S=300
CAP_VALIDATE_S=300
CAP_WRAPPER_S=1500
START_MIN_FREE_GIB=10
STOP_FREE_GIB=4
GUARD_INTERVAL_S=10
GUARD_STALE_S=45
